AWS_REGION=us-east-1
RAW_UPLOADS_BUCKET=your-raw-uploads-bucket
PROCESSED_VIDEOS_BUCKET=your-processed-videos-bucket
VIDEOS_TABLE=cloudcast-videos
USERS_TABLE=cloudcast-users
VIDEO_ID_INDEX=VideoIdIndex

CLOUDFRONT_DOMAIN=dxxxxxxxxxxxx.cloudfront.net
CLOUDFRONT_KEY_ID=APKAXXXXXEXAMPLE
# Provide either a path to the PEM file or the inline key value.
CLOUDFRONT_PRIVATE_KEY_PATH=./cloudfront_private_key.pem
CLOUDFRONT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----REPLACE_ME-----END PRIVATE KEY-----

COGNITO_USER_POOL_ID=us-east-1_ExamplePool
COGNITO_CLIENT_ID=exampleclientid123456789
COGNITO_REGION=us-east-1

# Optional overrides; defaults shown.
JWKS_CACHE_SECONDS=3600
MULTIPART_URL_EXPIRATION_SECONDS=3600
STREAM_URL_TTL_MINUTES=60

# Frontend origin allowlist (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:5173
# Optional: point to a local DynamoDB endpoint for dev (leave blank for AWS)
DYNAMODB_ENDPOINT_URL=
# Optional: override S3 endpoint (blank uses regional endpoint)
S3_ENDPOINT_URL=
