{
  "Comment": "CloudCast media processing pipeline",
  "QueryLanguage": "JSONata",
  "StartAt": "ExtractContext",
  "States": {
    "ExtractContext": {
      "Type": "Pass",
      "Assign": {
        "bucket": "{% $states.input.detail.bucket.name %}",
        "key": "{% $states.input.detail.object.key %}",
        "userId": "{% $split($states.input.detail.object.key, '/')[0] %}",
        "videoId": "{% $split($states.input.detail.object.key, '/')[1] %}",
        "processedBucket": "${ProcessedBucketName}",
        "videosTable": "${VideosTableName}"
      },
      "Next": "GetVideoMetadata"
    },
    "GetVideoMetadata": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "{% $videosTable %}",
        "Key": {
          "user_id": {
            "S": "{% $userId %}"
          },
          "id": {
            "S": "{% $videoId %}"
          }
        },
        "ProjectionExpression": "source_width, source_height"
      },
      "Assign": {
        "sourceWidth": "{% $exists($states.result.Item.source_width.N) ? $number($states.result.Item.source_width.N) : 0 %}",
        "sourceHeight": "{% $exists($states.result.Item.source_height.N) ? $number($states.result.Item.source_height.N) : 0 %}"
      },
      "Next": "SelectTranscodePolicy"
    },
    "SelectTranscodePolicy": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $sourceWidth >= 2560 and $sourceHeight >= 1440 %}",
          "Next": "Create1440pMediaConvertJob"
        },
        {
          "Condition": "{% $sourceWidth >= 1920 and $sourceHeight >= 1080 %}",
          "Next": "Create1080pMediaConvertJob"
        }
      ],
      "Default": "Create720pMediaConvertJob"
    },
    "Create1440pMediaConvertJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::mediaconvert:createJob.sync",
      "Arguments": {
        "Role": "${MediaConvertRoleArn}",
        "UserMetadata": {
          "video_id": "{% $videoId %}",
          "user_id": "{% $userId %}"
        },
        "Settings": {
          "Inputs": [
            {
              "FileInput": "{% 's3://' & $bucket & '/' & $key %}",
              "AudioSelectors": {
                "Audio Selector 1": {
                  "DefaultSelection": "DEFAULT"
                }
              },
              "VideoSelector": {}
            }
          ],
          "OutputGroups": [
            {
              "Name": "Apple HLS",
              "OutputGroupSettings": {
                "Type": "HLS_GROUP_SETTINGS",
                "HlsGroupSettings": {
                  "Destination": "{% 's3://' & $processedBucket & '/' & $userId & '/' & $videoId & '/hls/' %}",
                  "SegmentLength": 4,
                  "MinSegmentLength": 0
                }
              },
              "Outputs": [
                {
                  "ContainerSettings": {
                    "Container": "M3U8",
                    "M3u8Settings": {}
                  },
                  "VideoDescription": {
                    "Width": 2560,
                    "Height": 1440,
                    "CodecSettings": {
                      "Codec": "H_264",
                      "H264Settings": {
                        "RateControlMode": "QVBR",
                        "QualityTuningLevel": "SINGLE_PASS",
                        "MaxBitrate": 9000000,
                        "QvbrSettings": {
                          "QvbrQualityLevel": 7
                        },
                        "SceneChangeDetect": "TRANSITION_DETECTION"
                      }
                    }
                  },
                  "OutputSettings": {
                    "HlsSettings": {
                      "AudioGroupId": "program_audio",
                      "AudioRenditionSets": "program_audio",
                      "AudioOnlyContainer": "AUTOMATIC",
                      "IFrameOnlyManifest": "EXCLUDE"
                    }
                  },
                  "NameModifier": "_1440p"
                },
                {
                  "ContainerSettings": {
                    "Container": "M3U8",
                    "M3u8Settings": {}
                  },
                  "VideoDescription": {
                    "Width": 1920,
                    "Height": 1080,
                    "CodecSettings": {
                      "Codec": "H_264",
                      "H264Settings": {
                        "RateControlMode": "QVBR",
                        "QualityTuningLevel": "SINGLE_PASS",
                        "MaxBitrate": 5500000,
                        "QvbrSettings": {
                          "QvbrQualityLevel": 7
                        },
                        "SceneChangeDetect": "TRANSITION_DETECTION"
                      }
                    }
                  },
                  "OutputSettings": {
                    "HlsSettings": {
                      "AudioGroupId": "program_audio",
                      "AudioRenditionSets": "program_audio",
                      "AudioOnlyContainer": "AUTOMATIC",
                      "IFrameOnlyManifest": "EXCLUDE"
                    }
                  },
                  "NameModifier": "_1080p"
                },
                {
                  "ContainerSettings": {
                    "Container": "M3U8",
                    "M3u8Settings": {}
                  },
                  "VideoDescription": {
                    "Width": 1280,
                    "Height": 720,
                    "CodecSettings": {
                      "Codec": "H_264",
                      "H264Settings": {
                        "RateControlMode": "QVBR",
                        "QualityTuningLevel": "SINGLE_PASS",
                        "MaxBitrate": 3000000,
                        "QvbrSettings": {
                          "QvbrQualityLevel": 7
                        },
                        "SceneChangeDetect": "TRANSITION_DETECTION"
                      }
                    }
                  },
                  "OutputSettings": {
                    "HlsSettings": {
                      "AudioGroupId": "program_audio",
                      "AudioRenditionSets": "program_audio",
                      "AudioOnlyContainer": "AUTOMATIC",
                      "IFrameOnlyManifest": "EXCLUDE"
                    }
                  },
                  "NameModifier": "_720p"
                },
                {
                  "ContainerSettings": {
                    "Container": "M3U8",
                    "M3u8Settings": {}
                  },
                  "AudioDescriptions": [
                    {
                      "AudioSourceName": "Audio Selector 1",
                      "CodecSettings": {
                        "Codec": "AAC",
                        "AacSettings": {
                          "Bitrate": 128000,
                          "CodingMode": "CODING_MODE_2_0",
                          "SampleRate": 48000
                        }
                      }
                    }
                  ],
                  "OutputSettings": {
                    "HlsSettings": {
                      "AudioGroupId": "program_audio",
                      "AudioTrackType": "ALTERNATE_AUDIO_AUTO_SELECT_DEFAULT",
                      "AudioOnlyContainer": "AUTOMATIC",
                      "IFrameOnlyManifest": "EXCLUDE"
                    }
                  },
                  "NameModifier": "_audio"
                }
              ]
            }
          ]
        }
      },
      "Assign": {
        "createJobResult": "{% $states.result %}"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "MarkFailed"
        }
      ],
      "Next": "MarkReady"
    },
    "Create1080pMediaConvertJob": {
