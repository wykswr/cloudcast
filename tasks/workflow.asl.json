{
  "Comment": "CloudCast media processing pipeline",
  "QueryLanguage": "JSONata",
  "StartAt": "ExtractContext",
  "States": {
    "ExtractContext": {
      "Type": "Pass",
      "Assign": {
        "bucket": "{% $states.input.detail.bucket.name %}",
        "key": "{% $states.input.detail.object.key %}",
        "userId": "{% $split($states.input.detail.object.key, '/')[0] %}",
        "videoId": "{% $split($states.input.detail.object.key, '/')[1] %}",
        "processedBucket": "${ProcessedBucketName}",
        "videosTable": "${VideosTableName}"
      },
      "Next": "CreateMediaConvertJob"
    },
    "CreateMediaConvertJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::mediaconvert:createJob.sync",
      "Arguments": {
        "Role": "${MediaConvertRoleArn}",
        "UserMetadata": {
          "video_id": "{% $videoId %}",
          "user_id": "{% $userId %}"
        },
        "Settings": {
          "Inputs": [
            {
              "FileInput": "{% 's3://' & $bucket & '/' & $key %}",
              "AudioSelectors": {
                "Audio Selector 1": {
                  "DefaultSelection": "DEFAULT"
                }
              },
              "VideoSelector": {}
            }
          ],
          "OutputGroups": [
            {
              "Name": "Apple HLS",
              "OutputGroupSettings": {
                "Type": "HLS_GROUP_SETTINGS",
                "HlsGroupSettings": {
                  "Destination": "{% 's3://' & $processedBucket & '/' & $userId & '/' & $videoId & '/hls/' %}",
                  "SegmentLength": 4,
                  "MinSegmentLength": 0
                }
              },
              "Outputs": [
                {
                  "ContainerSettings": {
                    "Container": "M3U8",
                    "M3u8Settings": {}
                  },
                  "VideoDescription": {
                    "Width": 1920,
                    "Height": 1080,
                    "CodecSettings": {
                      "Codec": "H_264",
                      "H264Settings": {
                        "RateControlMode": "QVBR",
                        "MaxBitrate": 8000000,
                        "QvbrSettings": {
                          "QvbrQualityLevel": 8
                        }
                      }
                    }
                  },
                  "AudioDescriptions": [
                    {
                      "CodecSettings": {
                        "Codec": "AAC",
                        "AacSettings": {
                          "Bitrate": 128000,
                          "CodingMode": "CODING_MODE_2_0",
                          "SampleRate": 48000
                        }
                      }
                    }
                  ],
                  "NameModifier": "_1080p"
                }
              ]
            }
          ]
        }
      },
      "Assign": {
        "createJobResult": "{% $states.result %}"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "MarkFailed"
        }
      ],
      "Next": "MarkReady"
    },
    "MarkReady": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "{% $videosTable %}",
        "Key": {
          "user_id": {
            "S": "{% $userId %}"
          },
          "id": {
            "S": "{% $videoId %}"
          }
        },
        "UpdateExpression": "SET #status = :ready, s3_key_hls = :hls",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":ready": {
            "S": "ready"
          },
          ":hls": {
            "S": "{% $userId & '/' & $videoId & '/hls/' & $substringBefore($split($key, '/')[3], '.') & '.m3u8' %}"
          }
        }
      },
      "End": true
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "{% $videosTable %}",
        "Key": {
          "user_id": {
            "S": "{% $userId %}"
          },
          "id": {
            "S": "{% $videoId %}"
          }
        },
        "UpdateExpression": "SET #status = :failed",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":failed": {
            "S": "failed"
          }
        }
      },
      "End": true
    }
  }
}
