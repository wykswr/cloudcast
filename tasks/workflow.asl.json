{
  "Comment": "CloudCast media processing pipeline",
  "QueryLanguage": "JSONata",
  "StartAt": "ExtractContext",
  "States": {
    "ExtractContext": {
      "Type": "Pass",
      "Assign": {
        "bucket": "{% $states.input.detail.bucket.name %}",
        "key": "{% $states.input.detail.object.key %}",
        "userId": "{% $split($states.input.detail.object.key, '/')[0] %}",
        "videoId": "{% $split($states.input.detail.object.key, '/')[1] %}",
        "processedBucket": "${ProcessedBucketName}",
        "videosTable": "${VideosTableName}",
        "capacityProvider": "FARGATE_SPOT"
      },
      "Next": "RunTranscode"
    },
    "RunTranscode": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "TimeoutSeconds": 43200,
      "Arguments": {
        "Cluster": "${TranscoderClusterArn}",
        "TaskDefinition": "${TranscoderTaskDefinitionArn}",
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": "{% $capacityProvider %}",
            "Weight": 1
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["${TranscoderSubnetA}", "${TranscoderSubnetB}"],
            "SecurityGroups": ["${TranscoderSecurityGroupId}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "transcoder",
              "Environment": [
                {
                  "Name": "RAW_BUCKET",
                  "Value": "{% $bucket %}"
                },
                {
                  "Name": "RAW_KEY",
                  "Value": "{% $key %}"
                },
                {
                  "Name": "PROCESSED_BUCKET",
                  "Value": "{% $processedBucket %}"
                },
                {
                  "Name": "MANIFEST_KEY",
                  "Value": "{% $userId & '/' & $videoId & '/hls/' & $replace($split($key, '/')[-1], /\\.[^.]*$/, '') & '.m3u8' %}"
                }
              ]
            }
          ]
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": {
            "retryOnDemand": "{% $capacityProvider = 'FARGATE_SPOT' and $states.errorOutput.Error != 'States.Timeout' and $not($contains($exists($states.errorOutput.Cause) ? $states.errorOutput.Cause : '', /Essential ?[Cc]ontainer/)) %}"
          },
          "Next": "SelectRetry"
        }
      ],
      "Next": "MarkReady"
    },
    "SelectRetry": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $retryOnDemand %}",
          "Next": "UseOnDemandCapacity"
        }
      ],
      "Default": "MarkFailed"
    },
    "UseOnDemandCapacity": {
      "Type": "Pass",
      "Assign": {
        "capacityProvider": "FARGATE"
      },
      "Next": "RunTranscode"
    },
    "MarkReady": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "{% $videosTable %}",
        "Key": {
          "user_id": {
            "S": "{% $userId %}"
          },
          "id": {
            "S": "{% $videoId %}"
          }
        },
        "UpdateExpression": "SET #status = :ready, s3_key_hls = :hls",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":ready": {
            "S": "ready"
          },
          ":hls": {
            "S": "{% $userId & '/' & $videoId & '/hls/' & $replace($split($key, '/')[-1], /\\.[^.]*$/, '') & '.m3u8' %}"
          }
        }
      },
      "End": true
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "{% $videosTable %}",
        "Key": {
          "user_id": {
            "S": "{% $userId %}"
          },
          "id": {
            "S": "{% $videoId %}"
          }
        },
        "UpdateExpression": "SET #status = :failed",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":failed": {
            "S": "failed"
          }
        }
      },
      "End": true
    }
  }
}
